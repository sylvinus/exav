{
  "about": "The one table of the file formats exav handles. scripts/formats.mjs checks it against the code (the extractor's Format enum, Cargo features and streaming walkers, the scanner's FileType, the viewer's matchers and signatures) and writes the format matrix page and the summary sentences in the docs from it. Fields: id; name; kind; ext (lower case, with the dot; matched with endsWith); mime (the types the viewer sniffs, and the registered or common ones); magic (alternatives, each a list of offset:hex that must all hold); scan {type: exav-core FileType::as_str or null, mode: container | reported | view | type | none}; unpack {format: exav-unpack Format variant, feature: Cargo feature or null, read: stream | whole | reported}; sniffs (types the viewer sniffs from the bytes without claiming them); viewer (the plugin that opens it, or null); note. unpack.read is stream (members decoded as they are read), members (the container is read whole, its members stream out), whole, or reported (recognised, not decoded). The viewer's own test (ts/core/registry.test.ts) and the scanner's (tests/suites/format_registry.rs) read this file.",
  "kinds": {
    "archive": "Archives and compressed streams",
    "disk": "Disk images and filesystems",
    "installer": "Installers, self-extractors and packers",
    "document": "Documents",
    "mail": "Mail and encodings",
    "image": "Images",
    "drawing": "Drawings and 3D models",
    "media": "Video and audio",
    "text": "Text and code",
    "executable": "Executables and other carriers"
  },
  "scanModes": {
    "container": "opened, and every member scanned",
    "reported": "recognised and reported UNSCANNABLE or PASSWORD-PROTECTED, not opened",
    "view": "scanned through a text view as well as its bytes",
    "type": "typed by its content, its signatures applied",
    "none": "no type of its own"
  },
  "summaries": {
    "viewer": "PDF, images, DWG and DXF drawings, Word, Excel, PowerPoint and CSV, text (Markdown, JSON, XML, source code), IFC, STL, OBJ, PLY and glTF models, video, audio, and what is inside an archive",
    "files": ["README.md", "crates/exav-viewer/README.md", "www/src/content/docs/viewer/index.md"],
    "checks": [
      { "file": "README.md", "terms": ["PDF", "DWG", "DXF", "Word", "Excel", "PowerPoint", "CSV", "IFC", "STL", "OBJ", "PLY", "glTF"] },
      { "file": "crates/exav-viewer/package.json", "terms": ["PDF", "DWG", "DXF", "Word", "Excel", "PowerPoint", "CSV", "IFC", "STL", "OBJ", "PLY", "glTF"] },
      { "file": "crates/exav-viewer/demo/src/App.tsx", "terms": ["PDF", "DWG", "DXF", "Word", "Excel", "PowerPoint", "CSV", "IFC", "STL", "OBJ", "PLY", "glTF"] },
      { "file": "www/src/content/docs/index.mdx", "terms": ["PDF", "DWG", "DXF", "IFC", "STL", "OBJ", "PLY", "glTF"] },
      { "file": "www/src/content/docs/viewer/index.md", "terms": ["IFC", "STL", "OBJ", "PLY", "glTF"] },
      { "file": "www/src/content/docs/subprojects/exav-render.md", "terms": ["DWG", "DXF", "IFC", "STL", "OBJ", "PLY", "glTF"] }
    ]
  },
