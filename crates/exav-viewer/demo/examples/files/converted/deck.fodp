<office:body><office:presentation>
<draw:page draw:name="Title" draw:style-name="dp-title" draw:master-page-name="Master" presentation:presentation-page-layout-name="AL1"><draw:frame presentation:style-name="pr-title" draw:layer="layout" svg:width="24cm" svg:height="3cm" svg:x="2cm" svg:y="4.5cm" presentation:class="title" presentation:user-transformed="true"><draw:text-box><text:p text:style-name="P-big">Harbour review</text:p></draw:text-box></draw:frame><draw:frame presentation:style-name="pr-body" draw:layer="layout" svg:width="24cm" svg:height="2cm" svg:x="2cm" svg:y="8cm" presentation:class="subtitle"><draw:text-box><text:p text:style-name="P-sub">The east quay, first half of the year</text:p></draw:text-box></draw:frame><draw:ellipse draw:style-name="gr-grad" draw:layer="layout" svg:width="7cm" svg:height="7cm" svg:x="19cm" svg:y="9.5cm"><text:p text:style-name="P-center">exav</text:p></draw:ellipse><presentation:notes><draw:page-thumbnail presentation:class="page" draw:layer="layout" svg:width="14.8cm" svg:height="8.3cm" svg:x="3.2cm" svg:y="2cm"/><draw:frame presentation:class="notes" draw:layer="layout" svg:width="17cm" svg:height="12cm" svg:x="2cm" svg:y="11cm"><draw:text-box><text:p>Welcome. These notes are speaker notes: the viewer does not show them.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="Agenda" draw:style-name="dp-plain" draw:master-page-name="Master" presentation:presentation-page-layout-name="AL2"><draw:frame presentation:style-name="pr-title" draw:layer="layout" svg:width="24cm" svg:height="2.4cm" svg:x="2cm" svg:y="0.8cm" presentation:class="title" presentation:user-transformed="true"><draw:text-box><text:p text:style-name="P-title">Agenda</text:p></draw:text-box></draw:frame><draw:frame presentation:style-name="pr-body" draw:layer="layout" svg:width="24cm" svg:height="10cm" svg:x="2cm" svg:y="3.8cm" presentation:class="outline"><draw:text-box><text:list text:style-name="L-bul"><text:list-item><text:p text:style-name="P-body">Where we are</text:p></text:list-item><text:list-item><text:list><text:list-item><text:p text:style-name="P-body">berths let</text:p></text:list-item><text:list-item><text:list><text:list-item><text:p text:style-name="P-body">by length</text:p></text:list-item><text:list-item><text:p text:style-name="P-body">by season</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="P-body">visitors</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="P-body">What the figures say</text:p></text:list-item><text:list-item><text:p text:style-name="P-body">What we do next</text:p></text:list-item><text:list-item><text:list><text:list-item><text:p text:style-name="P-body">order the new chain</text:p></text:list-item><text:list-item><text:p text:style-name="P-body">paint the numbers</text:p></text:list-item></text:list></text:list-item></text:list></draw:text-box></draw:frame><presentation:notes><draw:page-thumbnail presentation:class="page" draw:layer="layout" svg:width="14.8cm" svg:height="8.3cm" svg:x="3.2cm" svg:y="2cm"/><draw:frame presentation:class="notes" draw:layer="layout" svg:width="17cm" svg:height="12cm" svg:x="2cm" svg:y="11cm"><draw:text-box><text:p>Four items.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="Chart" draw:style-name="dp-plain" draw:master-page-name="Master" presentation:presentation-page-layout-name="AL2"><draw:frame presentation:style-name="pr-title" draw:layer="layout" svg:width="24cm" svg:height="2.4cm" svg:x="2cm" svg:y="0.8cm" presentation:class="title" presentation:user-transformed="true"><draw:text-box><text:p text:style-name="P-title">Berths let, month by month</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="gr-none" draw:layer="layout" svg:width="19cm" svg:height="11cm" svg:x="2cm" svg:y="3.6cm"><draw:object><office:document office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.chart"><office:automatic-styles><style:style style:name="chs0" style:family="chart"><style:graphic-properties draw:stroke="none" svg:stroke-color="#146c94" draw:fill-color="#146c94"/></style:style><style:style style:name="chs1" style:family="chart"><style:graphic-properties draw:stroke="none" svg:stroke-color="#f6a01a" draw:fill-color="#f6a01a"/></style:style><style:style style:name="chs2" style:family="chart"><style:graphic-properties draw:stroke="none" svg:stroke-color="#2c7a4b" draw:fill-color="#2c7a4b"/></style:style><style:style style:name="chs3" style:family="chart"><style:graphic-properties draw:stroke="none" svg:stroke-color="#c0392b" draw:fill-color="#c0392b"/></style:style></office:automatic-styles><office:body><office:chart>
<chart:chart chart:class="chart:bar" svg:width="15cm" svg:height="8.5cm"><chart:title><text:p>Berths let by month</text:p></chart:title><chart:legend chart:legend-position="end"/>
<chart:plot-area table:cell-range-address="local-table.$A$1:.$C$7" chart:data-source-has-labels="both"><chart:axis chart:dimension="x" chart:name="primary-x"><chart:categories table:cell-range-address="local-table.$A$2:.$A$7"/></chart:axis><chart:axis chart:dimension="y" chart:name="primary-y"><chart:grid chart:class="major"/></chart:axis><chart:series chart:values-cell-range-address="local-table.$B$2:.$B$7" chart:label-cell-address="local-table.$B$1" chart:class="chart:bar" chart:style-name="chs0"><chart:data-point chart:repeated="1"/></chart:series><chart:series chart:values-cell-range-address="local-table.$C$2:.$C$7" chart:label-cell-address="local-table.$C$1" chart:class="chart:bar" chart:style-name="chs1"><chart:data-point chart:repeated="1"/></chart:series></chart:plot-area><table:table table:name="local-table"><table:table-header-columns><table:table-column/></table:table-header-columns><table:table-columns><table:table-column table:number-columns-repeated="2"/></table:table-columns><table:table-header-rows><table:table-row><table:table-cell><text:p/></table:table-cell><table:table-cell office:value-type="string"><text:p>This year</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>Last year</text:p></table:table-cell></table:table-row></table:table-header-rows><table:table-rows><table:table-row><table:table-cell office:value-type="string"><text:p>Jan</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="20"><text:p>20</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="18"><text:p>18</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Feb</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="26"><text:p>26</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="23"><text:p>23</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Mar</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="32"><text:p>32</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="28"><text:p>28</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Apr</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="38"><text:p>38</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="33"><text:p>33</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>May</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="44"><text:p>44</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="38"><text:p>38</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell office:value-type="string"><text:p>Jun</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="50"><text:p>50</text:p></table:table-cell><table:table-cell office:value-type="float" office:value="43"><text:p>43</text:p></table:table-cell></table:table-row></table:table-rows></table:table></chart:chart></office:chart></office:body></office:document></draw:object></draw:frame><draw:custom-shape draw:style-name="gr-callout" draw:layer="layout" svg:width="5.5cm" svg:height="3cm" svg:x="21.5cm" svg:y="5cm"><text:p text:style-name="P-center">Up 40% on last year</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangular-callout" draw:enhanced-path="M 3590 0 X 0 3590 L 0 14370 Y 3590 17960 L 7200 17960 L 5400 21600 L 10800 17960 L 18010 17960 X 21600 14370 L 21600 3590 Y 18010 0 Z N"/></draw:custom-shape><presentation:notes><draw:page-thumbnail presentation:class="page" draw:layer="layout" svg:width="14.8cm" svg:height="8.3cm" svg:x="3.2cm" svg:y="2cm"/><draw:frame presentation:class="notes" draw:layer="layout" svg:width="17cm" svg:height="12cm" svg:x="2cm" svg:y="11cm"><draw:text-box><text:p>The chart is a native chart, with its data inside the slide.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page><draw:page draw:name="Table" draw:style-name="dp-plain" draw:master-page-name="Master" presentation:presentation-page-layout-name="AL2"><draw:frame presentation:style-name="pr-title" draw:layer="layout" svg:width="24cm" svg:height="2.4cm" svg:x="2cm" svg:y="0.8cm" presentation:class="title" presentation:user-transformed="true"><draw:text-box><text:p text:style-name="P-title">Fees</text:p></draw:text-box></draw:frame><draw:frame draw:layer="layout" svg:width="16cm" svg:height="8cm" svg:x="2cm" svg:y="4cm"><table:table table:style-name="tb1"><table:table-column table:style-name="tcol1"/><table:table-column table:style-name="tcol2"/><table:table-column table:style-name="tcol2"/><table:table-row><table:table-cell table:style-name="tc-head" office:value-type="string"><text:p text:style-name="P-th">Length</text:p></table:table-cell><table:table-cell table:style-name="tc-head" office:value-type="string"><text:p text:style-name="P-th">Berths</text:p></table:table-cell><table:table-cell table:style-name="tc-head" office:value-type="string"><text:p text:style-name="P-th">Fee</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">up to 6 m</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">12</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">18.00</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">6 to 8 m</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">18</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">24.50</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">8 to 10 m</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">14</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">31.00</text:p></table:table-cell></table:table-row><table:table-row><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">over 10 m</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">16</text:p></table:table-cell><table:table-cell table:style-name="tc" office:value-type="string"><text:p text:style-name="P-td">48.00</text:p></table:table-cell></table:table-row></table:table></draw:frame><draw:frame presentation:style-name="pr-body" draw:layer="layout" svg:width="8cm" svg:height="8cm" svg:x="19cm" svg:y="4cm" presentation:class="outline"><draw:text-box><text:list text:style-name="L-bul"><text:list-item><text:p text:style-name="P-body">Season fee includes water</text:p></text:list-item><text:list-item><text:p text:style-name="P-body">Power is metered</text:p></text:list-item><text:list-item><text:p text:style-name="P-body">Visitors pay by the night</text:p></text:list-item></text:list></draw:text-box></draw:frame></draw:page><draw:page draw:name="Picture" draw:style-name="dp-plain" draw:master-page-name="Master" presentation:presentation-page-layout-name="AL2"><draw:frame presentation:style-name="pr-title" draw:layer="layout" svg:width="24cm" svg:height="2.4cm" svg:x="2cm" svg:y="0.8cm" presentation:class="title" presentation:user-transformed="true"><draw:text-box><text:p text:style-name="P-title">A picture and shapes</text:p></draw:text-box></draw:frame><draw:frame draw:layer="layout" svg:width="12.8cm" svg:height="7.2cm" svg:x="2cm" svg:y="4cm"><draw:image><office:binary-data></office:binary-data></draw:image><svg:title>A lake at dusk</svg:title></draw:frame><draw:rect draw:style-name="gr-grad" draw:layer="layout" svg:width="4cm" svg:height="2.4cm" svg:x="16cm" svg:y="4cm"><text:p text:style-name="P-center">Start</text:p></draw:rect><draw:line draw:style-name="gr-arrow" draw:layer="layout" svg:x1="20cm" svg:y1="5.2cm" svg:x2="22.5cm" svg:y2="5.2cm"/><draw:ellipse draw:style-name="gr-fill2" draw:layer="layout" svg:width="3.4cm" svg:height="2.4cm" svg:x="22.8cm" svg:y="4cm"><text:p text:style-name="P-center">Moor</text:p></draw:ellipse><draw:line draw:style-name="gr-arrow" draw:layer="layout" svg:x1="24.5cm" svg:y1="6.4cm" svg:x2="24.5cm" svg:y2="8.4cm"/><draw:polygon draw:style-name="gr-fill3" draw:layer="layout" svg:width="4cm" svg:height="3cm" svg:x="22.5cm" svg:y="8.5cm" svg:viewBox="0 0 4000 3000" draw:points="2000,0 4000,1500 2000,3000 0,1500"><text:p text:style-name="P-center">Pay?</text:p></draw:polygon><draw:custom-shape draw:style-name="gr-fill4" draw:layer="layout" svg:width="4cm" svg:height="3cm" svg:x="16.5cm" svg:y="8.5cm"><text:p text:style-name="P-center">Star</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="star5" draw:enhanced-path="M 10800 0 L 8270 8260 0 8260 6720 13360 4200 21600 10800 16500 17400 21600 14880 13360 21600 8260 13330 8260 Z N"/></draw:custom-shape><presentation:notes><draw:page-thumbnail presentation:class="page" draw:layer="layout" svg:width="14.8cm" svg:height="8.3cm" svg:x="3.2cm" svg:y="2cm"/><draw:frame presentation:class="notes" draw:layer="layout" svg:width="17cm" svg:height="12cm" svg:x="2cm" svg:y="11cm"><draw:text-box><text:p>Shapes with gradients, arrows and text.</text:p></draw:text-box></draw:frame></presentation:notes></draw:page>
