<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
 <office:styles>
  <style:style style:name="standard" style:family="graphic">
   <style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.05cm" draw:fill="none"/>
   <style:text-properties fo:font-size="14pt"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PLarge">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="14.8cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/>
  </style:page-layout>
  <style:page-layout style:name="PSmall">
   <style:page-layout-properties fo:page-width="10cm" fo:page-height="10cm" fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm"/>
  </style:page-layout>
  <style:style style:name="red" style:family="graphic" style:parent-style-name="standard">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#cc2222"/>
  </style:style>
  <style:style style:name="blue" style:family="graphic" style:parent-style-name="standard">
   <style:graphic-properties draw:fill="solid" draw:fill-color="#2244cc" draw:stroke="none"/>
  </style:style>
  <style:style style:name="pagebg" style:family="drawing-page">
   <style:drawing-page-properties draw:fill="solid" draw:fill-color="#f4f0d8"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <draw:layer-set>
   <draw:layer draw:name="layout"/>
   <draw:layer draw:name="notes" draw:display="none"/>
  </draw:layer-set>
  <style:master-page style:name="Large" style:page-layout-name="PLarge">
   <draw:rect draw:style-name="standard" draw:layer="backgroundobjects" svg:x="0.5cm" svg:y="0.5cm" svg:width="20cm" svg:height="13.8cm"/>
  </style:master-page>
  <style:master-page style:name="Small" style:page-layout-name="PSmall"/>
 </office:master-styles>
 <office:body>
  <office:drawing>
   <draw:page draw:name="Plan" draw:style-name="pagebg" draw:master-page-name="Large">
    <draw:rect draw:style-name="red" draw:layer="layout" svg:x="2cm" svg:y="2cm" svg:width="6cm" svg:height="4cm">
     <text:p>Red box</text:p>
    </draw:rect>
    <draw:ellipse draw:style-name="blue" draw:layer="layout" svg:x="10cm" svg:y="3cm" svg:width="5cm" svg:height="5cm"/>
    <draw:line draw:style-name="standard" draw:layer="layout" svg:x1="2cm" svg:y1="10cm" svg:x2="18cm" svg:y2="12cm"/>
    <draw:rect draw:style-name="red" draw:layer="notes" svg:x="14cm" svg:y="9cm" svg:width="4cm" svg:height="2cm">
     <text:p>Hidden note</text:p>
    </draw:rect>
   </draw:page>
   <draw:page draw:name="Detail" draw:master-page-name="Small">
    <draw:custom-shape draw:style-name="blue" draw:layer="layout" svg:x="1cm" svg:y="1cm" svg:width="8cm" svg:height="4cm">
     <text:p>Detail</text:p>
     <draw:enhanced-geometry draw:type="round-rectangle" draw:enhanced-path="M 3600 0 X 0 3600 L 0 18000 Y 3600 21600 L 18000 21600 X 21600 18000 L 21600 3600 Y 18000 0 Z N"/>
    </draw:custom-shape>
   </draw:page>
  </office:drawing>
 </office:body>
</office:document>
