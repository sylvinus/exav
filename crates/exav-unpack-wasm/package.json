{
  "name": "exav-unpack-wasm",
  "version": "0.1.0",
  "type": "module",
  "description": "WebAssembly bindings for exav-unpack: in-browser, memory-safe universal archive extraction. Supports zip, rar, 7z, tar, gz, bz2, xz, cab, arj, lha, iso, cpio, ar, xar, ole, pdf, email, UPX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sylvinus/exav.git"
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "js/worker.js",
    "pkg/exav_unpack_wasm_bg.wasm",
    "pkg/exav_unpack_wasm.js",
    "pkg/exav_unpack_wasm.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./worker": "./js/worker.js"
  },
  "keywords": [
    "wasm",
    "webassembly",
    "archive",
    "zip",
    "rar",
    "7z",
    "tar",
    "extract",
    "unpack",
    "decompress",
    "security",
    "sandbox"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build": "wasm-pack build --release --target web",
    "build:e2e": "wasm-pack build --release --target web -- --features testing-faults",
    "build:full": "wasm-pack build --release --target web -- --no-default-features --features full",
    "build:minimal": "wasm-pack build --release --target web -- --no-default-features --features minimal",
    "prepublishOnly": "npm run build && node -e \"for (const f of ['LICENSE','NOTICE','README.md']) if (!require('fs').existsSync(f)) { console.error('refusing to publish without ' + f + ': publish from the crate root, not pkg/'); process.exit(1); }\"",
    "serve": "npx serve . -l 3847"
  },
  "author": "Sylvain Zimmer",
  "bugs": {
    "url": "https://github.com/sylvinus/exav/issues"
  },
  "homepage": "https://github.com/sylvinus/exav#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "serve": "^14.2.6",
    "vitest": "^4.1.9"
  }
}
