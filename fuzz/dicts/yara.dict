# YARA rule syntax, for the `yara` target (the rule text is behind a two-byte length).
"rule "
"private rule "
"global rule "
"import \"pe\"\x0a"
"import \"elf\"\x0a"
"import \"math\"\x0a"
"import \"hash\"\x0a"
"import \"string\"\x0a"
"import \"dotnet\"\x0a"
"import \"time\"\x0a"
"meta:\x0a"
"strings:\x0a"
"condition:\x0a"
"nocase"
"wide"
"ascii"
"fullword"
"private"
"base64"
"base64wide"
"xor(1-255)"
"xor(0x01-0xff)"
"all of them"
"any of them"
"2 of ($a, $b)"
"for any i in (1..#a) : ("
"for all of ($a*) : ("
"filesize"
"entrypoint"
"uint8("
"uint16("
"uint32("
"int16be("
"@a[1]"
"!a[1]"
"#a in (0..100)"
"$a at 0"
"$a in (0..filesize)"
"pe.is_pe"
"pe.number_of_sections"
"pe.sections[0].name"
"pe.imports(\"kernel32.dll\", \"LoadLibraryA\")"
"pe.imphash()"
"elf.type == elf.ET_EXEC"
"math.entropy(0, filesize)"
"hash.md5(0, filesize)"
"hash.sha256(0, 16)"
"matches /"
"contains \""
"icontains \""
"startswith \""
"endswith \""
"defined "
"not "
" and "
" or "
"1KB"
"1MB"
"{ 4D 5A ?? ?? [2-4] ( 50 | 4B ) ~00 }"
"/[a-z]{2,8}\\b/i"
"/(a|b)*c\\d+/s"
"\\x41"
"\\w+"
