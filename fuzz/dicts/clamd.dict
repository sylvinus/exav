# The clamd protocol, for the `clamd` target (its lines are written from
# structured input; these are for the `Line` commands and the names).
"PING"
"VERSION"
"VERSIONCOMMANDS"
"STATS"
"RELOAD"
"SHUTDOWN"
"QUIT"
"IDSESSION"
"SESSION"
"END"
"INSTREAM"
"EXINSTREAM"
"EXINSTREAM MULTI"
"FILDES"
"SCAN "
"CONTSCAN "
"MULTISCAN "
"ALLMATCHSCAN "
"SCANURL "
"zPING\x00"
"nPING\x0a"
"nIDSESSION\x0a"
"nEND\x0a"
"UNKNOWN COMMAND"
