# ICAP (RFC 3507) and the HTTP it carries, for the `icap` target. The target
# writes its own requests from structured input; these are for the strings in it.
"REQMOD"
"RESPMOD"
"OPTIONS"
"icap://127.0.0.1/avscan ICAP/1.0\x0d\x0a"
"ICAP/1.0"
"Encapsulated: "
"req-hdr=0"
"res-hdr=0"
"req-body="
"res-body="
"null-body="
"opt-body="
"Preview: "
"Allow: 204"
"Allow: 206"
"X-Client-IP: "
"X-Authenticated-User: "
"Connection: close"
"; ieof"
"\x0d\x0a\x0d\x0a"
"0\x0d\x0a\x0d\x0a"
"GET / HTTP/1.1"
"POST /upload HTTP/1.1"
"HTTP/1.1 200 OK"
"Content-Length: "
"Transfer-Encoding: chunked"
"Content-Type: multipart/form-data; boundary="
"Content-Disposition: form-data; name=\"f\"; filename=\""
